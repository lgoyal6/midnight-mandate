# Remote networks only. Never commit a real mnemonic or seed.
MIDNIGHT_PREPROD_MNEMONIC=
# Alternative to the mnemonic; set exactly one of the two.
# MIDNIGHT_PREPROD_SEED=
# Only needed if the wallet holds multiple unshielded colors and native NIGHT
# cannot be inferred.
# MIDNIGHT_NIGHT_COLOR=
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
