{
  "name": "midnight-mandate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private, contract-enforced spending mandates for AI agents on Midnight.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contracts/mandate.compact contracts/managed/mandate",
    "test": "NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "test:contract": "NODE_OPTIONS='--experimental-vm-modules' vitest run src/test/mandate.test.ts",
    "test:proposal": "NODE_OPTIONS='--experimental-vm-modules' vitest run src/test/proposal.test.ts",
    "test:local": "MIDNIGHT_NETWORK=local NODE_OPTIONS='--experimental-vm-modules' vitest run src/test/local.test.ts",
    "test:preprod": "yarn compile && yarn env:up && MIDNIGHT_NETWORK=preprod tsx --env-file-if-exists=.env.preprod scripts/preprod.ts",
    "env:up": "tsx scripts/env-up.ts",
    "env:down": "docker compose down",
    "proof:up": "docker compose up -d --wait proof-server",
    "proof:down": "docker compose stop proof-server",
    "typecheck": "tsc --noEmit",
    "demo:smoke": "yarn compile && yarn test:contract && yarn test:proposal && yarn typecheck && yarn env:up && MIDNIGHT_NETWORK=local tsx scripts/smoke.ts",
    "proposal:live": "tsx scripts/live-proposal.ts",
    "demo:api": "tsx src/demo-server.ts",
    "web": "vite --config vite.config.ts",
    "web:build": "vite build --config vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "demo:ui": "yarn env:up && concurrently --kill-others --names api,web --prefix-colors blue,green \"yarn demo:api\" \"yarn web\""
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "pino": "9.14.0",
    "pino-pretty": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxjs": "7.8.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.21.0",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "4.1.0"
  },
  "resolutions": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
